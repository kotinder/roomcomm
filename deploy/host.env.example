# Copy to deploy/host.env (gitignored) and fill in. Read by deploy/DEPLOY.md.
# No secrets here: the app's secrets stay in $APP_DIR/.env on the host.

# ssh target with root on the host (an alias from ~/.ssh/config works).
# Disable any port forwards the alias sets: ssh -o ClearAllForwardings=yes
HOST=
# Build context on the host: app/, Dockerfile, requirements.txt, .env
APP_DIR=
# The roomcomm site file nginx loads
NGINX_SITE=/etc/nginx/sites-enabled/commroom
# Where nginx backups go — outside sites-enabled
NGINX_BACKUPS=/root/nginx-backups
