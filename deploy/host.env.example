# Copy to deploy/host.env (gitignored by *.env) and fill in. Read by
# deploy/DEPLOY.md. No secrets here: the app's own secrets stay in the .env
# inside APP_DIR on the host.

# ssh target with root on the host (an alias from ~/.ssh/config works; if the
# alias sets port forwards, add -o ClearAllForwardings=yes to its use)
HOST=
# Build context on the host: app/, static/, scripts/, Dockerfile,
# requirements.txt and the app's .env
APP_DIR=
# The file in nginx's sites-enabled that serves roomcomm
NGINX_SITE=
# A directory for nginx backups, outside sites-enabled
NGINX_BACKUPS=
